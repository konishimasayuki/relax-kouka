{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "booking.spatheceada.com" }],
      "destination": "/booking.html"
    },
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
